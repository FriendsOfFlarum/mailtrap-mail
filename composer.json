{
    "name": "fof/mailtrap-mail",
    "description": "Send your forum mail through the Mailtrap API, or catch it in a Mailtrap sandbox",
    "keywords": [
        "flarum",
        "mail",
        "mailtrap",
        "sandbox"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/mailtrap-mail/issues",
        "source": "https://github.com/FriendsOfFlarum/mailtrap-mail",
        "forum": "https://discuss.flarum.org/d/40097"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^2.1",
        "railsware/mailtrap-php": "^3.16",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/mailtrap-mailer": "^7.4 || ^8.0"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\MailtrapMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\MailtrapMail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Mailtrap Mail",
            "category": "feature",
            "icon": {
                "image": "resources/logo.svg",
                "backgroundColor": "#e74c3c",
                "color": "#fff",
                "backgroundSize": "60%",
                "backgroundRepeat": "no-repeat",
                "backgroundPosition": "center"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
