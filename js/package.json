{
  "name": "@fof/mailtrap-mail",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "prettier": "@flarum/prettier-config",
  "devDependencies": {
    "@flarum/jest-config": "^2.0.2",
    "@flarum/prettier-config": "^1.0.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.6",
    "prettier": "^2.5.1",
    "typescript": "^4.9.5",
    "typescript-coverage-report": "^0.6.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^4.9.1"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "format": "prettier --write src tests",
    "format-check": "prettier --check src tests",
    "clean-typings": "npx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "yarn run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && yarn run post-build-typings",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i.bak 's,../src/@types,@types,g' && find dist-typings -type f -name '*.d.ts.bak' -delete",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false",
    "check-typings-coverage": "typescript-coverage-report",
    "test": "yarn node --experimental-vm-modules $(yarn bin jest)"
  }
}
